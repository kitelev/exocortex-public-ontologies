@prefix ems: <https://exocortex.my/ontology/ems#> .
@prefix exo: <https://exocortex.my/ontology/exo#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix vann: <http://purl.org/vocab/vann/> .

<https://exocortex.my/ontology/ems#> a owl:Ontology ;
    rdfs:label "EMS - Effort Management System Ontology"@en ;
    rdfs:comment "Ontology for task management, project planning, and effort tracking in Exocortex. Key concepts: Tasks, Projects, Areas, Ideas, Sessions, Meetings, and OKRs with status tracking and timestamps."@en ;
    vann:preferredNamespacePrefix "ems" ;
    vann:preferredNamespaceUri "https://exocortex.my/ontology/ems#" ;
    owl:versionInfo "1.0.0" ;
    owl:imports <https://exocortex.my/ontology/exo#> .

# Core Effort Types

ems:Effort a owl:Class ;
    rdfs:label "Effort"@en ;
    rdfs:comment "Base class for all trackable efforts"@en ;
    rdfs:subClassOf exo:Asset .

ems:ParentEffort a owl:Class ;
    rdfs:label "Parent Effort"@en ;
    rdfs:comment "Effort that contains child efforts"@en ;
    rdfs:subClassOf ems:Effort .

ems:Task a owl:Class ;
    rdfs:label "Task"@en ;
    rdfs:comment "Atomic unit of work"@en ;
    rdfs:subClassOf ems:Effort .

ems:Project a owl:Class ;
    rdfs:label "Project"@en ;
    rdfs:comment "Collection of related tasks"@en ;
    rdfs:subClassOf ems:ParentEffort .

ems:Area a owl:Class ;
    rdfs:label "Area"@en ;
    rdfs:comment "Life area (Work, Health, Learning, etc.)"@en ;
    rdfs:subClassOf ems:ParentEffort .

ems:Idea a owl:Class ;
    rdfs:label "Idea"@en ;
    rdfs:comment "Captured thought or concept for future development"@en ;
    rdfs:subClassOf ems:Effort .

ems:Initiative a owl:Class ;
    rdfs:label "Initiative"@en ;
    rdfs:comment "Strategic initiative spanning multiple projects"@en ;
    rdfs:subClassOf ems:ParentEffort .

ems:Bug a owl:Class ;
    rdfs:label "Bug"@en ;
    rdfs:comment "Software defect to be fixed"@en ;
    rdfs:subClassOf ems:Task .

# Effort Status Classes

ems:EffortStatus a owl:Class ;
    rdfs:label "Effort Status"@en ;
    rdfs:comment "Status enumeration for efforts"@en .

ems:EffortStatusBacklog a owl:Class ;
    rdfs:label "Backlog"@en ;
    rdfs:comment "Effort is in backlog, not yet scheduled"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusToDo a owl:Class ;
    rdfs:label "To Do"@en ;
    rdfs:comment "Effort is scheduled to be done"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusThisWeek a owl:Class ;
    rdfs:label "This Week"@en ;
    rdfs:comment "Effort planned for this week"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusDoing a owl:Class ;
    rdfs:label "Doing"@en ;
    rdfs:comment "Effort is currently in progress"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusDone a owl:Class ;
    rdfs:label "Done"@en ;
    rdfs:comment "Effort has been completed"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusTrashed a owl:Class ;
    rdfs:label "Trashed"@en ;
    rdfs:comment "Effort has been discarded"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusDraft a owl:Class ;
    rdfs:label "Draft"@en ;
    rdfs:comment "Effort is in draft state, not finalized"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusClarifying a owl:Class ;
    rdfs:label "Clarifying"@en ;
    rdfs:comment "Effort requires clarification before work"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusAcknowledgement a owl:Class ;
    rdfs:label "Acknowledgement"@en ;
    rdfs:comment "Effort awaiting acknowledgement"@en ;
    rdfs:subClassOf ems:EffortStatus .

ems:EffortStatusBusinessAnalysis a owl:Class ;
    rdfs:label "Business Analysis"@en ;
    rdfs:comment "Effort in business analysis phase"@en ;
    rdfs:subClassOf ems:EffortStatus .

# Meetings & Sessions

ems:Meeting a owl:Class ;
    rdfs:label "Meeting"@en ;
    rdfs:comment "Scheduled meeting with participants"@en ;
    rdfs:subClassOf ems:Effort .

ems:MeetingFormat a owl:Class ;
    rdfs:label "Meeting Format"@en ;
    rdfs:comment "Format of meeting (online/offline)"@en .

ems:OnlineMeetingFormat a owl:Class ;
    rdfs:label "Online"@en ;
    rdfs:comment "Virtual/remote meeting"@en ;
    rdfs:subClassOf ems:MeetingFormat .

ems:OfflineMeetingFormat a owl:Class ;
    rdfs:label "Offline"@en ;
    rdfs:comment "In-person meeting"@en ;
    rdfs:subClassOf ems:MeetingFormat .

ems:MeetingPrototype a owl:Class ;
    rdfs:label "Meeting Prototype"@en ;
    rdfs:comment "Template for recurring meetings"@en ;
    rdfs:subClassOf exo:Prototype .

ems:Session a owl:Class ;
    rdfs:label "Session"@en ;
    rdfs:comment "Focused work session"@en ;
    rdfs:subClassOf ems:Effort .

ems:SessionPrototype a owl:Class ;
    rdfs:label "Session Prototype"@en ;
    rdfs:comment "Template for work sessions"@en ;
    rdfs:subClassOf exo:Prototype .

ems:SessionType a owl:Class ;
    rdfs:label "Session Type"@en ;
    rdfs:comment "Type of work session"@en .

ems:TransportingSession a owl:Class ;
    rdfs:label "Transporting Session"@en ;
    rdfs:comment "Travel time between locations"@en ;
    rdfs:subClassOf ems:Session .

# OKRs (Objectives & Key Results)

ems:OKR a owl:Class ;
    rdfs:label "OKR"@en ;
    rdfs:comment "Objective and Key Results"@en ;
    rdfs:subClassOf ems:ParentEffort .

ems:YearlyObjective a owl:Class ;
    rdfs:label "Yearly Objective"@en ;
    rdfs:comment "Annual objective"@en ;
    rdfs:subClassOf ems:OKR .

ems:QuarterlyObjective a owl:Class ;
    rdfs:label "Quarterly Objective"@en ;
    rdfs:comment "Quarterly objective"@en ;
    rdfs:subClassOf ems:OKR .

ems:MonthlyObjective a owl:Class ;
    rdfs:label "Monthly Objective"@en ;
    rdfs:comment "Monthly objective"@en ;
    rdfs:subClassOf ems:OKR .

ems:WeeklyObjective a owl:Class ;
    rdfs:label "Weekly Objective"@en ;
    rdfs:comment "Weekly objective"@en ;
    rdfs:subClassOf ems:OKR .

# Prototypes & Metadata

ems:TaskPrototype a owl:Class ;
    rdfs:label "Task Prototype"@en ;
    rdfs:comment "Template for creating tasks"@en ;
    rdfs:subClassOf exo:Prototype .

ems:ProjectPrototype a owl:Class ;
    rdfs:label "Project Prototype"@en ;
    rdfs:comment "Template for creating projects"@en ;
    rdfs:subClassOf exo:Prototype .

ems:EffortPrototype a owl:Class ;
    rdfs:label "Effort Prototype"@en ;
    rdfs:comment "Base template for efforts"@en ;
    rdfs:subClassOf exo:Prototype .

ems:TaskCategory a owl:Class ;
    rdfs:label "Task Category"@en ;
    rdfs:comment "Category for task classification"@en .

ems:TaskContext a owl:Class ;
    rdfs:label "Task Context"@en ;
    rdfs:comment "Context where task can be done (@home, @work, @phone)"@en .

ems:TaskSize a owl:Class ;
    rdfs:label "Task Size"@en ;
    rdfs:comment "T-shirt sizing for task estimation (S, M, L, XL)"@en .

ems:TaskZone a owl:Class ;
    rdfs:label "Task Zone"@en ;
    rdfs:comment "Energy zone for task (creative, routine, administrative)"@en .

ems:EffortColor a owl:Class ;
    rdfs:label "Effort Color"@en ;
    rdfs:comment "Visual color indicator for effort"@en .

ems:EffortParticipant a owl:Class ;
    rdfs:label "Effort Participant"@en ;
    rdfs:comment "Participant in an effort"@en .

ems:EffortParticipants a owl:Class ;
    rdfs:label "Effort Participants"@en ;
    rdfs:comment "Collection of participants"@en ;
    rdfs:subClassOf exo:Collection .

ems:EffortResponsible a owl:Class ;
    rdfs:label "Effort Responsible"@en ;
    rdfs:comment "Person responsible for effort completion"@en .

ems:CurrentFocus a owl:Class ;
    rdfs:label "Current Focus"@en ;
    rdfs:comment "Currently active focus area"@en .

# Special Task Types

ems:ExtTask a owl:Class ;
    rdfs:label "External Task"@en ;
    rdfs:comment "Task from external system (GitHub, Jira, etc.)"@en ;
    rdfs:subClassOf ems:Task .

ems:WaitingTask a owl:Class ;
    rdfs:label "Waiting Task"@en ;
    rdfs:comment "Task blocked/waiting for something"@en ;
    rdfs:subClassOf ems:Task .

ems:Recurring a owl:Class ;
    rdfs:label "Recurring"@en ;
    rdfs:comment "Recurring effort pattern"@en .

# Properties

ems:Effort_status a owl:ObjectProperty ;
    rdfs:label "status"@en ;
    rdfs:comment "Current status of the effort"@en ;
    rdfs:domain ems:Effort ;
    rdfs:range ems:EffortStatus ;
    rdfs:subPropertyOf exo:Asset_status .

ems:Effort_area a owl:ObjectProperty ;
    rdfs:label "area"@en ;
    rdfs:comment "Life area this effort belongs to"@en ;
    rdfs:domain ems:Effort ;
    rdfs:range ems:Area ;
    rdfs:subPropertyOf exo:Asset_area .

ems:Effort_parent a owl:ObjectProperty ;
    rdfs:label "parent"@en ;
    rdfs:comment "Parent effort in hierarchy"@en ;
    rdfs:domain ems:Effort ;
    rdfs:range ems:ParentEffort ;
    rdfs:subPropertyOf exo:Asset_parent .

ems:Effort_project a owl:ObjectProperty ;
    rdfs:label "project"@en ;
    rdfs:comment "Project this effort belongs to"@en ;
    rdfs:domain ems:Effort ;
    rdfs:range ems:Project ;
    rdfs:subPropertyOf exo:Asset_project .

ems:Effort_priority a owl:DatatypeProperty ;
    rdfs:label "priority"@en ;
    rdfs:comment "Priority level of the effort"@en ;
    rdfs:domain ems:Effort ;
    rdfs:subPropertyOf exo:Asset_priority .

ems:Effort_startTimestamp a owl:DatatypeProperty ;
    rdfs:label "startTimestamp"@en ;
    rdfs:comment "Actual start time"@en ;
    rdfs:domain ems:Effort ;
    rdfs:subPropertyOf exo:Asset_startTimestamp .

ems:Effort_endTimestamp a owl:DatatypeProperty ;
    rdfs:label "endTimestamp"@en ;
    rdfs:comment "Actual end time"@en ;
    rdfs:domain ems:Effort ;
    rdfs:subPropertyOf exo:Asset_endTimestamp .

ems:Effort_plannedStartTimestamp a owl:DatatypeProperty ;
    rdfs:label "plannedStartTimestamp"@en ;
    rdfs:comment "Planned start time"@en ;
    rdfs:domain ems:Effort ;
    rdfs:subPropertyOf exo:Asset_plannedStartTimestamp .

ems:Effort_plannedEndTimestamp a owl:DatatypeProperty ;
    rdfs:label "plannedEndTimestamp"@en ;
    rdfs:comment "Planned end time"@en ;
    rdfs:domain ems:Effort ;
    rdfs:subPropertyOf exo:Asset_plannedEndTimestamp .
