    <rdfs:comment xml:lang="en">Namespace URL of ontology</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_createdAt">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">createdAt</rdfs:label>
    <rdfs:comment xml:lang="en">Creation timestamp</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/created"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_relates">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">relates</rdfs:label>
    <rdfs:comment xml:lang="en">Generic relation to another asset</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/relation"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Asset</rdfs:label>
    <rdfs:comment xml:lang="en">Base class for all knowledge assets in Exocortex</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Relation">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Relation</rdfs:label>
    <rdfs:comment xml:lang="en">Semantic relation between assets</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Property">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
