    <rdfs:label xml:lang="en">isDefinedBy</rdfs:label>
    <rdfs:comment xml:lang="en">Reference to defining resource</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#isDefinedBy"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Statement">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Statement</rdfs:label>
    <rdfs:comment xml:lang="en">RDF statement (triple)</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Statement"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#URLProperty">
