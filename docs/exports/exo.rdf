    <rdfs:comment xml:lang="en">Property with date range</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#TimeProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
