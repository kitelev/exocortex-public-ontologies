    <rdfs:label xml:lang="en">String Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property with string range</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_isDefinedBy">
