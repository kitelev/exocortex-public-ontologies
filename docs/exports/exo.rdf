    <rdfs:comment xml:lang="en">Base class for all properties</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#PropertyCardinality">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Property Cardinality</rdfs:label>
    <rdfs:comment xml:lang="en">Cardinality constraint for properties</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Resource">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Resource</rdfs:label>
    <rdfs:comment xml:lang="en">Base resource type</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Resource"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Instance">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Instance</rdfs:label>
    <rdfs:comment xml:lang="en">Instance of a class</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Property_domain">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">domain</rdfs:label>
    <rdfs:comment xml:lang="en">Domain class of a property</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Property"/>
    <rdfs:range rdf:resource="https://exocortex.my/ontology/exo#Class"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#domain"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_fileName">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">fileName</rdfs:label>
    <rdfs:comment xml:lang="en">File name in vault</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#True">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">True</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean true value</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#Boolean"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#PropertyCardinalitySingle">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Single Cardinality</rdfs:label>
    <rdfs:comment xml:lang="en">Property allows single value</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#PropertyCardinality"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#TimestampProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Timestamp Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property with timestamp range</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#FunctionSignatureInputArgument">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Function Signature Input Argument</rdfs:label>
    <rdfs:comment xml:lang="en">Input argument for function signatures</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Prototype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Prototype</rdfs:label>
    <rdfs:comment xml:lang="en">Template for creating instances</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_label">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">label</rdfs:label>
    <rdfs:comment xml:lang="en">Human-readable label for an asset</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#label"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#PropertyCardinalityMultiple">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Multiple Cardinality</rdfs:label>
    <rdfs:comment xml:lang="en">Property allows multiple values</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#PropertyCardinality"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_description">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">description</rdfs:label>
    <rdfs:comment xml:lang="en">Textual description of an asset</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/terms/description"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Property_range">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">range</rdfs:label>
    <rdfs:comment xml:lang="en">Range class of a property</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Property"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#range"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_bodyLink">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">bodyLink</rdfs:label>
    <rdfs:comment xml:lang="en">Links extracted from body content</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
