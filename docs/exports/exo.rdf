    <rdfs:comment xml:lang="en">Property marked for removal</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_prototype">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">prototype</rdfs:label>
    <rdfs:comment xml:lang="en">Reference to template/prototype</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
    <rdfs:range rdf:resource="https://exocortex.my/ontology/exo#Prototype"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Instance_class">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">class</rdfs:label>
    <rdfs:comment xml:lang="en">Class of an instance</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Instance"/>
    <rdfs:range rdf:resource="https://exocortex.my/ontology/exo#Class"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Ontology_url">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
