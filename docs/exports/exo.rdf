  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#OntologyAlias">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ontology Alias</rdfs:label>
    <rdfs:comment xml:lang="en">Prefix alias for namespace</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Boolean">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boolean</rdfs:label>
    <rdfs:comment xml:lang="en">Boolean value type</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#DeprecatedProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
