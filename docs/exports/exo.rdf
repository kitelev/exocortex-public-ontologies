    <rdfs:comment xml:lang="en">Property with UUID range</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Class_superClass">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">superClass</rdfs:label>
    <rdfs:comment xml:lang="en">Parent class in hierarchy</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Class"/>
    <rdfs:range rdf:resource="https://exocortex.my/ontology/exo#Class"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Ontology">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Ontology definition</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#DatatypeProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Datatype Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property with literal value</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label xml:lang="en">EXO - Exocortex Core Ontology</rdfs:label>
    <rdfs:comment xml:lang="en">Core ontology for Exocortex knowledge management system. Defines fundamental concepts: Assets, Classes, Properties, Instances, and their relationships. Provides interoperability with standard RDF/RDFS/OWL vocabularies.</rdfs:comment>
    <vann:preferredNamespacePrefix>exo</vann:preferredNamespacePrefix>
    <vann:preferredNamespaceUri>https://exocortex.my/ontology/exo#</vann:preferredNamespaceUri>
    <owl:versionInfo>1.0.0</owl:versionInfo>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Asset_uid">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">uid</rdfs:label>
    <rdfs:comment xml:lang="en">Unique identifier for an asset</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Asset"/>
    <rdfs:subPropertyOf rdf:resource="http://purl.org/dc/elements/1.1/identifier"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#NumberProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Number Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property with numeric range</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#DateProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
