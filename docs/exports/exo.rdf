    <rdfs:label xml:lang="en">URL Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property with URL range</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#ObjectProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Object Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property linking to another resource</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Collection">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Collection</rdfs:label>
    <rdfs:comment xml:lang="en">Container for multiple items</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Class">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Class</rdfs:label>
    <rdfs:comment xml:lang="en">Represents a class definition</rdfs:comment>
    <rdfs:subClassOf rdf:resource="http://www.w3.org/2000/01/rdf-schema#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#MetaProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Meta Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property about properties</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#Property"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#Ontology_imports">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">imports</rdfs:label>
    <rdfs:comment xml:lang="en">Imported ontology</rdfs:comment>
    <rdfs:domain rdf:resource="https://exocortex.my/ontology/exo#Ontology"/>
    <rdfs:range rdf:resource="https://exocortex.my/ontology/exo#Ontology"/>
    <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#imports"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#BooleanProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Boolean Property</rdfs:label>
    <rdfs:comment xml:lang="en">Property with boolean range</rdfs:comment>
    <rdfs:subClassOf rdf:resource="https://exocortex.my/ontology/exo#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="https://exocortex.my/ontology/exo#UUIDProperty">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
